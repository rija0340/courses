          "lessons": [
            {
              "id": "verb-to-be",
              "title": {
                "fr": "Le verbe Être (To Be)",
                "mg": "Ny matoanteny To Be",
                "en": "The verb To Be"
              },
              "description": {
                "fr": "Conjugaison et utilisation du verbe le plus important.",
                "mg": "Fampihenjana sy fampiasana ny matoanteny manan-danja indrindra.",
                "en": "Conjugation and use of the most important verb."
              },
              "coverImage": "https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=900&q=80",
              "estimatedMinutes": 12,
              "introduction": {
                "fr": "Le verbe 'to be' est le verbe le plus utilisé en anglais. Il décrit un état, une identité ou une caractéristique.",
                "mg": "Ny matoanteny 'to be' no be mpampiasa indrindra amin'ny teny anglisy. Izy io dia mamaritra toetra, maha-izy azy na marika.",
                "en": "The verb 'to be' is the most used verb in English. It describes a state, an identity, or a characteristic."
              },
              "sections": [
                {
                  "type": "image",
                  "src": "https://images.unsplash.com/photo-1522202176988-662653fb3834?auto=format&fit=crop&w=1400&q=80",
                  "caption": {
                    "fr": "Présentez-vous avec am / is / are",
                    "en": "Introduce yourself with am / is / are",
                    "mg": "Ampahafantaro ny tenanao amin'ny am / is / are"
                  }
                },
                {
                  "type": "core-concept",
                  "title": {
                    "fr": "Formes au Présent",
                    "mg": "Amin'ny fotoana ankehitriny",
                    "en": "Present Form"
                  },
                  "content": [
                    {
                      "text": {
                        "fr": "Le verbe 'to be' a 3 formes au présent:",
                        "mg": "Ny matoanteny 'to be' dia misy endrika 3 ankehitriny:",
                        "en": "The verb 'to be' has 3 forms in the present:"
                      },
                      "items": [
                        { "text": " am ", "highlight": "key-term" },
                        { "text": ", ", "highlight": "none" },
                        { "text": " is ", "highlight": "key-term" },
                        { "text": ", ", "highlight": "none" },
                        { "text": " are ", "highlight": "key-term" }
                      ]
                    },
                    {
                      "type": "definition",
                      "term": "I am",
                      "highlight": "important",
                      "definitions": {
                        "fr": "Je suis (Je suis étudiant -> I am a student).",
                        "mg": "Izaho dia (Mpianatra aho -> I am a student).",
                        "en": "I am (I am a student)."
                      }
                    },
                    {
                      "type": "definition",
                      "term": "He / She / It is",
                      "highlight": "important",
                      "definitions": {
                        "fr": "Il / Elle / C'est (Il est grand -> He is tall).",
                        "mg": "Izy / Izy (zavatra) dia (Avo izy -> He is tall).",
                        "en": "He / She / It is (He is tall)."
                      }
                    },
                    {
                      "type": "definition",
                      "term": "You / We / They are",
                      "highlight": "important",
                      "definitions": {
                        "fr": "Tu es / Nous sommes / Ils sont (Vous êtes prêts -> You are ready).",
                        "mg": "Ianao / Isika / Izy ireo dia (Vonona ianareo -> You are ready).",
                        "en": "You / We / They are (You are ready)."
                      }
                    }
                  ]
                },
                {
                  "type": "dialogue",
                  "title": {
                    "fr": "Dialogue court",
                    "en": "Short dialogue",
                    "mg": "Resaka fohy"
                  },
                  "lines": [
                    {
                      "speaker": "A",
                      "text": { "fr": "Hi! I am Maya.", "en": "Hi! I am Maya.", "mg": "Hi! I am Maya." }
                    },
                    {
                      "speaker": "B",
                      "text": { "fr": "Hello! I am Tom. Are you a student?", "en": "Hello! I am Tom. Are you a student?", "mg": "Hello! I am Tom. Are you a student?" }
                    },
                    {
                      "speaker": "A",
                      "text": { "fr": "Yes, I am. He is my teacher.", "en": "Yes, I am. He is my teacher.", "mg": "Yes, I am. He is my teacher." }
                    }
                  ]
                },
                {
                  "type": "tip",
                  "title": { "fr": "Astuce", "en": "Tip", "mg": "Torohevitra" },
                  "text": {
                    "fr": "Avec I → toujours am. Avec he/she/it → is. Avec you/we/they → are.",
                    "en": "With I → always am. With he/she/it → is. With you/we/they → are.",
                    "mg": "Miaraka amin'ny I → am foana. He/she/it → is. You/we/they → are."
                  }
                },
                {
                  "type": "example",
                  "title": { "fr": "Exemple", "en": "Example", "mg": "Ohatra" },
                  "text": { "fr": "She is a doctor.", "en": "She is a doctor.", "mg": "She is a doctor." },
                  "translation": {
                    "fr": "Elle est médecin.",
                    "en": "She is a doctor.",
                    "mg": "Dokotera izy."
                  }
                }
              ],
