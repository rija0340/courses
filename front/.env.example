# Copy to front/.env.local and fill values.
# Dashboard Supabase: Project Settings > API
#
# Vercel: set Root Directory = "front"

REACT_APP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_ANON_KEY
REACT_APP_STORAGE_PROVIDER=supabase

# Schema: supabase/migrations + legacy supabase_schema.sql (vocab_* / course_packs)
# RAG: Edge Functions ingest + chat (medi-vocabs, gte-small → pgvector)

# --- Practice (Deepgram + Groq via local API / Vercel) ---
REACT_APP_PRACTICE_ENABLED=true
REACT_APP_SPEECH_PROVIDER=remote
REACT_APP_LLM_PROVIDER=remote
REACT_APP_AI_GATEWAY_URL=http://localhost:3001

# --- Server secrets for front/api (NOT REACT_APP_*) ---
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000
AI_RATE_LIMIT_PER_MIN=30
# GROQ_MODEL=llama-3.3-70b-versatile

# Also set GROQ_API_KEY as a Supabase Edge Function secret for /functions/v1/chat
# Optional: INGEST_SECRET for non-JWT ingest calls
