# Copy to .env.local and fill values.
# Dashboard Supabase: Project Settings > API

REACT_APP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_ANON_KEY
REACT_APP_STORAGE_PROVIDER=supabase

# --- Practice (Deepgram + Groq via local API / Vercel) ---
REACT_APP_PRACTICE_ENABLED=true
REACT_APP_SPEECH_PROVIDER=remote
REACT_APP_LLM_PROVIDER=remote
REACT_APP_AI_GATEWAY_URL=http://localhost:3001

# --- Server secrets (REQUIRED for remote practice — NOT REACT_APP_*) ---
# Get keys: https://console.groq.com  |  https://console.deepgram.com
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000
AI_RATE_LIMIT_PER_MIN=30
# DEEPGRAM_STT_MODEL=nova-2
# DEEPGRAM_TTS_MODEL=aura-asteria-en
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional Vercel token if using USE_VERCEL_DEV=1
# VERCEL_TOKEN=
